"ref"
{
    "preset"
	{
		"name"		"MenuControls"
		"group_source_bindings"
		{
			{{! Right Joystick }}
			{{#if (equals mouseZone "right_joystick")}}
				"/groups/right_joystick/mouse.vdf"						"right_joystick active"
				"/groups/right_joystick/slow-mouse.vdf"					"right_joystick active modeshift"
			{{/if}}
			
			{{! Right Trackpad }}
			{{#if (equals mouseZone "right_trackpad")}}
				"/groups/right_trackpad/mouse.vdf"						"right_trackpad active"
			{{/if}}
			
			{{! Left Joystick }}
			"/groups/joystick/arrows.vdf"								"joystick active"
			
			{{! Left Trackpad }}
			{{#if (equals altMouseZone "left_trackpad")}}
				"/groups/left_trackpad/mouse.vdf"						"left_trackpad active"
			{{/if}}

			{{! dpadZone }}
			"/groups/dpadZone/click-scroll.vdf?preset=Menu"             "{{dpadZone}} active"
			
			{{! Button diamond }}
			"/groups/button_diamond/accept-cancel.vdf"		            "button_diamond active"
			"/groups/button_diamond/timewarp.vdf"						"button_diamond active modeshift"
			
			{{! Left Trigger }}
			"/groups/left_trigger/right-click.vdf"						"left_trigger active"
			
			{{! Right Trigger }}
			"/groups/right_trigger/left-click.vdf"						"right_trigger active"
			
			{{! Switch }}
			"/groups/switches/menu.vdf"				                    "switch active"
		}
	}
}
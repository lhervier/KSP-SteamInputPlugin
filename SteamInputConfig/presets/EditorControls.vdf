"ref"
{
    "preset"
	{
		"name"		"EditorControls"
		"group_source_bindings"
		{
			{{! Right Joystick }}
			{{#if (equals mouseZone "right_joystick")}}
				"/groups/right_joystick/mouse.vdf"									"right_joystick active"
				"/groups/right_joystick/slow-mouse.vdf"								"right_joystick active modeshift"
			{{else}}
				"/groups/right_joystick/camera.vdf"		             				"right_joystick active"
			{{/if}}
			
			{{! Right Trackpad }}
			{{#if (equals mouseZone "right_trackpad")}}
				"/groups/right_trackpad/mouse.vdf"									"right_trackpad active"
			{{/if}}
			
			{{! Left Joystick }}
			"/groups/joystick/editor/rotate-part.vdf"								"joystick active"
			"/groups/joystick/editor/place-offset-rotate-root.vdf"					"joystick active modeshift"
			
			{{! dpadZone }}
			"/groups/dpadZone/click-scroll.vdf?preset=Editor"										"{{dpadZone}} active"

			{{! Button diamond }}
			"/groups/button_diamond/editor/reset_rot-delete-sym_cycle-snap.vdf"		"button_diamond active"
			"/groups/button_diamond/editor/sym-frame.vdf"							"button_diamond active modeshift"
			
			{{! Left Trigger }}
			"/groups/left_trigger/editor/right-click-slew.vdf"						"left_trigger active"
			
			{{! Right Trigger }}
			"/groups/right_trigger/left-click.vdf"									"right_trigger active"
			
			{{! Switch }}
			"/groups/switches/editor.vdf"											"switch active"
		}
	}
}